{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Free, private job radar: polls company career sites (Greenhouse, Lever, Ashby, Workday) and surfaces new postings.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "poll": "tsx packages/worker/src/poll.ts",
    "poll:dry": "tsx packages/worker/src/poll.ts --dry-run",
    "discover": "tsx packages/worker/src/discover.ts",
    "workday-test": "tsx packages/worker/src/workday-test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
